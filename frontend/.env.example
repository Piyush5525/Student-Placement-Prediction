# Base URL of the FastAPI backend. The Axios client (src/lib/api-client.ts)
# reads this via import.meta.env.VITE_API_BASE_URL. Copy this file to .env
# (and adjust the value) for local development.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Google OAuth Client ID — public by design, safe to expose to the browser
# (the Client SECRET stays server-side only, in backend/.env). Must match
# backend/.env's GOOGLE_CLIENT_ID, and the redirect URI below must be
# registered in Google Cloud Console under this client's Authorized
# redirect URIs.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# GitHub OAuth Client ID — public by design, safe to expose to the browser
# (the Client SECRET stays server-side only, in backend/.env). Must match
# backend/.env's GITHUB_CLIENT_ID, and the redirect URI below must be
# registered as the GitHub OAuth App's Authorization callback URL.
VITE_GITHUB_CLIENT_ID=
VITE_GITHUB_REDIRECT_URI=http://localhost:5173/app/settings/github/callback
