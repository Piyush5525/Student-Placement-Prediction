# Copy this file to .env and fill in real values. .env is gitignored.

# --- JWT ---
# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Google OAuth ---
# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID.
# Leave blank to run the API with Google login disabled (every other endpoint
# still works; POST /auth/google returns 503 until these are set).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# --- GitHub OAuth (account linking, not login) ---
# From GitHub > Settings > Developer settings > OAuth Apps > New OAuth App.
# Leave blank to run the API with GitHub linking disabled (every other
# endpoint still works; POST /integrations/github/connect returns 503 until
# these are set).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/app/settings/github/callback

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Resume upload ---
MAX_RESUME_SIZE_MB=5

# --- Placement prediction ML model ---
# Directory containing placement_model.pkl, scaler.pkl, target_encoder.pkl,
# metadata.json. Defaults to <repo root>/models — override only if you move
# the artifacts elsewhere.
# ML_MODELS_DIR=
